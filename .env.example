# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored. The app runs without any of these set — it falls back to a
# bundled demo menu and disables checkout — so you can wire things up one at a
# time.
# ----------------------------------------------------------------------------

# Public site URL (used for Stripe redirect URLs and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch mode — "prelaunch" or "live". Defaults to "prelaunch" if unset (and
# any value other than "live" is treated as prelaunch — fails safe so the
# site never accidentally takes a real payment). Pre-launch hides the Stripe
# "pay online" path, forces the Bread Club into waitlist mode, shows a banner,
# and refuses /api/checkout + /api/bread-club server-side. Flip to "live"
# (Cloudflare → Settings → Builds → Variables) the day your CFO permit
# clears, then re-trigger a build.
NEXT_PUBLIC_LAUNCH_MODE=prelaunch

# --- Stripe -----------------------------------------------------------------
# https://dashboard.stripe.com/apikeys  (use test keys in development)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or the webhook endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring Price ID for the weekly "Bread Club" subscription.
STRIPE_BREAD_CLUB_PRICE_ID=

# --- Sanity (headless CMS for the menu) -------------------------------------
# Run `npx sanity@latest init --env` in this folder to create a project and
# populate these. Without them the storefront uses src/lib/seed-products.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# A write token (Editor) — only needed so the Stripe webhook can decrement
# drop inventory after a paid order. Create at https://sanity.io/manage
SANITY_API_WRITE_TOKEN=

# --- Bread Club magic links -------------------------------------------------
# Used to sign per-drop selection links sent to members. Any long random
# string; rotate to invalidate every outstanding link at once. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLUB_LINK_SECRET=

# --- Admin pages ------------------------------------------------------------
# Password for /admin/login. You enter it once on the login page and the
# session is remembered in an HttpOnly cookie for 30 days. Rotate to revoke
# every active admin session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BAKER_TOKEN=

# --- Resend (transactional email) -------------------------------------------
# https://resend.com → API keys. Free tier ~3k/mo. Bread Club confirmation
# emails go through this; magic-link emails will use it too once #3 ships.
# Until you verify a sending domain, Resend only delivers to the email the
# account is registered with; the default FROM_EMAIL below is Resend's shared
# test sender (onboarding@resend.dev).
RESEND_API_KEY=
FROM_EMAIL=Doughbie <onboarding@resend.dev>
